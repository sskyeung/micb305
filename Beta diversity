mds_data = mds$points %>% as.data.frame %>%
  merge(sample_data(psrare), by='row.names', sort=F)
head(mds_data)
#), Green ( or #008000), Blue (#0000FF), and Yellow (#FFFF00

p = mds_data %>%
  ggplot(aes(MDS1,MDS2,color = Vitamin_C)) +
  geom_point() +
  stat_ellipse() +
  labs(title= str_wrap('Bray-Curtis Beta Diversity between Vitamin C intake levels and PD Onset', width = 50)) + 
  scale_color_manual(name = "Vitamin C intake", values = c("High" = "#FF0000", "Low" = "#00FF00", "Typical" = "#0000FF")) +
  theme_classic(base_size=15) +
  theme(plot.title = element_text(hjust = 0.5))
p
