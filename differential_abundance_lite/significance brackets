library(ggplot2)
library(dplyr)

# Ensure factor levels for x-axis
daa_data$Vitamin_C <- factor(
  daa_data$Vitamin_C,
  levels = c("Low", "typical", "High")
)

# Prepare significance annotation dataframe
signif_df <- vc_daa_sig %>%
  select(Genus, q_label) %>%
  mutate(
    label = case_when(
      q_label < 0.001 ~ "***",
      q_label < 0.01  ~ "**",
      q_label < 0.05  ~ "*",
      TRUE ~ "ns"
    )
  ) %>%
  left_join(
    daa_data %>%
      group_by(Genus) %>%
      summarise(
        q3     = quantile(Abundance, 0.75, na.rm = TRUE),
        ymax   = max(Abundance, na.rm = TRUE),
        iqr    = IQR(Abundance, na.rm = TRUE),
        yrange = diff(range(Abundance, na.rm = TRUE)),
        .groups = "drop"
      ),
    by = "Genus"
  ) %>%
  mutate(
    # safeguards against degenerate distributions
    iqr    = ifelse(iqr <= 0, 1e-6, iqr),
    yrange = ifelse(yrange <= 0, 1e-6, yrange),

    # choose the larger scale so brackets never collapse
    scale_ref = pmax(iqr, 0.15 * yrange),

    # vertical placement
    y_bracket = ymax + 0.25 * scale_ref,
    y_text    = ymax + 0.45 * scale_ref,
    bracket_height = 0.20 * scale_ref
  ) %>%
  filter(label != "ns")   # remove non-significant ones (optional)

# Base plot
p <- ggplot(
  daa_data,
  aes(x = Vitamin_C, y = Abundance, fill = Vitamin_C)
) +
  geom_boxplot(outlier.shape = NA) +
  scale_fill_manual(
    values = c(
      "Low"     = "blue",
      "typical" = "green",
      "High"    = "red"
    )
  ) +
  facet_wrap(~ Genus, scales = "free", ncol = 3) +
  labs(
    x = "Vitamin C Intake",
    y = "Relative Abundance (%)"
  ) +
  theme_minimal() +
  theme(
    panel.grid = element_blank(),
    axis.line = element_line(colour = "black"),
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.position = "none",
    strip.text = element_text(face = "italic")
  )

# Add significance brackets and stars
final_plot <- p +
  # horizontal bracket
  geom_segment(
    data = signif_df,
    aes(x = 1, xend = 3, y = y_bracket, yend = y_bracket),
    inherit.aes = FALSE,
    linewidth = 0.6
  ) +
  # left leg
  geom_segment(
    data = signif_df,
    aes(
      x = 1, xend = 1,
      y = y_bracket,
      yend = y_bracket - bracket_height
    ),
    inherit.aes = FALSE,
    linewidth = 0.6
  ) +
  # right leg
  geom_segment(
    data = signif_df,
    aes(
      x = 3, xend = 3,
      y = y_bracket,
      yend = y_bracket - bracket_height
    ),
    inherit.aes = FALSE,
    linewidth = 0.6
  ) +
  # significance label
  geom_text(
    data = signif_df,
    aes(x = 2, y = y_text, label = label),
    inherit.aes = FALSE,
    size = 5
  ) +
  # tighten whitespace without crushing brackets
  scale_y_continuous(expand = expansion(mult = c(0.05, 0.12)))

# Display plot
final_plot
