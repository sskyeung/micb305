make phyloseq object
```{r}
taxonomy = read.delim('project_data/taxonomy.tsv', row.names = 1) # from qiime2
counts = read.delim('project_data/feature-table.txt', skip=1, row.names=1)  # from qiime2
tree = read_tree("project_data/tree.nwk")

taxonomy_formatted = taxonomy %>%
  separate(col = Taxon,
           into = c("Domain", "Phylum", "Class", "Order", "Family", "Genus", "Species"),
           sep = ";", fill = "right") %>%
  select(-Confidence) %>%
  as.matrix()

counts_formatted = counts %>%
  as.matrix()

#rownames(PD_binned) <- PD_binned$X.SampleID

ps = phyloseq(sample_data(PD_binned),
              otu_table(counts_formatted, taxa_are_rows = TRUE),
              tax_table(taxonomy_formatted), tree)

saveRDS(ps, "project_data/phyloseq_taxonomy_binned.rds")

```



```{r beta diversity}
###VIT C BETA DIVERSITY GRAPH CODE###

set.seed(421)
psrare = ps %>% rarefy_even_depth(sample.size = 9555, rngseed = 421) # 66 samples removed for being lower than sample size

#ps_bray = phyloseq::distance(psrare, method = "bray")

ps_vitC <- subset_samples(psrare, !is.na(Vitamin_C))

ps_bray <- phyloseq::distance(ps_vitC, method = "bray")

vitc_metadata <- sample_data(ps_vitC) %>% data.frame()

Vit_C_stats_univar <- adonis2(ps_bray ~ Vitamin_C, data = vitc_metadata)

#PMA_metadata = sample_data(psrare) %>% data.frame() 

#Vit_C_stats_univar = adonis2(ps_bray ~ Vitamin_C, data = PMA_metadata)

# Combine into a table
Vit_C_stats = bind_rows('Univariate' = Vit_C_stats_univar %>% as.data.frame() %>% 
                    rownames_to_column('Variable'),
                  .id = 'Model') # First column is Model, either Uni or Multi

Vit_C_stats = Vit_C_stats %>% rename(Pval = `Pr(>F)`) %>%
  filter(!is.na(Pval))

Vit_C_stats 

mds = metaMDS(ps_bray)

mds_data_vitC = mds$points %>% as.data.frame %>%
  merge(sample_data(ps_vitC), by='row.names', sort=F)
head(mds_data_vitC)

p_vitC = mds_data_vitC %>%
  ggplot(aes(MDS1,MDS2,color = Vitamin_C, shape = Vitamin_C)) +
  geom_point() +
  stat_ellipse() +
  labs(title= str_wrap('Bray-Curtis Beta Diversity Across Vitamin C Intake Groups', width = 50)) + 
  scale_color_manual(name = "Vitamin C Intake", values = c("High" = "#F5793A", "Low" = "#E03C8A", "Typical" = "#005AB5")) +
  scale_shape_manual(name = "Vitamin C Intake", values = c("High" = 16, "Low" = 17, "Typical" = 15))+
  theme_classic(base_size=15) +
  theme(plot.title = element_text(hjust = 0.5))
p_vitC

ggsave("beta_diversity_vitC.png",
       p_vitC,
