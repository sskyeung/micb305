```{r beta diversity}
set.seed(421)
psrare = ps %>% rarefy_even_depth(sample.size = 9500, rngseed = 421) # 66 samples removed for being lower than sample size

ps_bray = phyloseq::distance(psrare, method = "bray")
```

```{r Alpha}
Alpha_stats_univar = adonis2(ps_bray ~ Alpha_carotene, data = PMA_metadata)

# Combine into a table
Alpha_stats = bind_rows('Univariate' = Alpha_stats_univar %>% as.data.frame() %>% 
                    rownames_to_column('Variable'),
                  .id = 'Model') # First column is Model, either Uni or Multi

Alpha_stats = Alpha_stats %>% rename(Pval = `Pr(>F)`) %>%
  filter(!is.na(Pval))

Alpha_stats 

```

